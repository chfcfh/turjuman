<!-- About. Faz3a fork: shows the app's own name, that it is a modified version of CouchSubs by Sinan Yorulmaz (AGPL-3.0
     section 5a), the licence, the translation model's CC BY 4.0 credit and the upstream copyright line. -->
<Window x:Class="CouchSubs.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CouchSubs.App.Controls"
        xmlns:t="clr-namespace:CouchSubs.App.Theme"
        Title="{t:T 'About CouchSubs'}" Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="True"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource windowBackgroundBrush}" Foreground="{DynamicResource textPrimaryBrush}">
    <Grid>
    <c:ProjectorLight />
    <Border Style="{StaticResource CardBorder}" Margin="{t:Sp 'l'}">
        <StackPanel>
            <TextBlock Text="{t:T 'About'}" Style="{StaticResource SectionLabel}" />
            <c:CouchLogo Width="110" Height="80" HorizontalAlignment="Center" Margin="{t:Sp '0,xs,0,0'}" Animated="False" FlowDirection="LeftToRight">
                <c:CouchLogo.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.45" Color="#F5B83D" RenderingBias="Performance" />
                </c:CouchLogo.Effect>
            </c:CouchLogo>
            <TextBlock x:Name="AppName" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="{t:Sp '0,s,0,0'}" />
            <TextBlock x:Name="Version" Style="{StaticResource MonoText}" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" Margin="{t:Sp '0,xxs,0,s'}" FlowDirection="LeftToRight" />
            <TextBlock Text="{t:T 'Modified version of CouchSubs'}" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="{t:T 'Based on CouchSubs by Sinan Yorulmaz (AGPL-3.0). Modified by Faz3a in 2026: Arabic translation and interface, DeepSeek, offline English→Arabic model; game packs, the shared line pool, usage data, updates and ads removed.'}"
                       Style="{StaticResource HintText}" TextAlignment="Center" Margin="{t:Sp '0,xxs,0,0'}" />
            <TextBlock Text="{t:T 'Free and open source under the GNU AGPL-3.0 license.'}" Style="{StaticResource HintText}" TextAlignment="Center" Margin="{t:Sp '0,xs,0,0'}" />
            <TextBlock Text="{t:T 'Translation model: opus-mt-tc-big-en-ar by Helsinki-NLP / OPUS-MT, University of Helsinki (CC BY 4.0), converted to ONNX by Faz3a.'}"
                       Style="{StaticResource HintText}" TextAlignment="Center" Margin="{t:Sp '0,xs,0,0'}" />
            <TextBlock Text="{t:T 'No subtitle line is ever sent anywhere, except to the translation service you choose with your own key.'}"
                       Style="{StaticResource HintText}" TextAlignment="Center" Margin="{t:Sp '0,xs,0,0'}" />
            <TextBlock Text="{t:T 'Remote Play connection by chiaki-ng (AGPL-3.0). Thanks to its developers.'}" Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="{t:Sp '0,s,0,0'}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{t:Sp '0,m,0,0'}">
                <!-- AGPL-3.0: where this modified version's complete source code is. -->
                <Button Content="{t:T 'Source code'}" Style="{StaticResource SmallSecondaryButton}" Height="40" Tag="https://github.com/chfcfh/turjuman" Click="OnLink" />
                <Button Content="CouchSubs" Style="{StaticResource SmallSecondaryButton}" Height="40" Margin="{t:Sp 'xs,0,0,0'}" Tag="https://github.com/yorulmazsinan/couchsubs" Click="OnLink" />
                <Button Content="OPUS-MT" Style="{StaticResource SmallSecondaryButton}" Height="40" Margin="{t:Sp 'xs,0,0,0'}" Tag="https://huggingface.co/Helsinki-NLP/opus-mt-tc-big-en-ar" Click="OnLink" />
                <Button Content="chiaki-ng" Style="{StaticResource SmallSecondaryButton}" Height="40" Margin="{t:Sp 'xs,0,0,0'}" Tag="https://github.com/chiaki-ng/chiaki-ng" Click="OnLink" />
            </StackPanel>
            <!-- Upstream copyright lines, kept as required by CouchSubs' NOTICE (AGPL-3.0 section 4). -->
            <TextBlock Text="CouchSubs — Copyright © 2026 Sinan Yorulmaz (Enmera)" FontSize="11" Foreground="{DynamicResource textTertiaryBrush}" HorizontalAlignment="Center" Margin="{t:Sp '0,l,0,0'}" FlowDirection="LeftToRight" />
            <TextBlock Text="Modified by Faz3a, 2026" FontSize="11" Foreground="{DynamicResource textTertiaryBrush}" HorizontalAlignment="Center" Margin="{t:Sp '0,xxs,0,0'}" FlowDirection="LeftToRight" />
            <Button Content="{t:T 'Close'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="{t:Sp '0,m,0,0'}" IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
